# Copier en .env (jamais versionné) et compléter. Tous les champs sont optionnels sauf SEC_USER_AGENT.
SEC_USER_AGENT="Prénom Nom email@exemple.com"   # exigé par la SEC (déclaratif)
EODHD_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
ANTHROPIC_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=          # mot de passe d'application Gmail, pas le mot de passe du compte
REPORT_TO=
